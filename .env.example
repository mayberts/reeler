# Drizzle
DATABASE_URL=local.db

# Everything below is optional here — it can also be set (or changed later) from the
# in-app Settings page (admin only) once you've logged in, which takes priority over
# these values. Only PLEX_CLIENT_IDENTIFIER is actually needed to sign in for the first
# time, since it's the only one Plex OAuth login itself uses.

# Plex
PLEX_SERVER_URL=http://your-plex-server:32400
PLEX_TOKEN=
# Shared secret used in the webhook URL path (/api/webhooks/plex/<token>), since
# Plex does not sign webhook requests. Generate any random string.
PLEX_WEBHOOK_TOKEN=
# Stable id identifying this app instance to plex.tv for the OAuth sign-in flow.
# Any fixed random string (e.g. `openssl rand -hex 16`).
PLEX_CLIENT_IDENTIFIER=

# TMDb (optional) — powers movie/TV metadata and manually logging things not in your
# Plex library. A v4 "Read Access Token", not the older v3 API key: themoviedb.org
# account -> Settings -> API. Leave blank to disable.
TMDB_API_KEY=

# TVDB (optional) — fallback metadata source for shows TMDb doesn't have.
# Free API key: thetvdb.com. Leave blank to disable.
TVDB_API_KEY=

# MusicBrainz needs no key/config — it's used automatically for manual music logging.
