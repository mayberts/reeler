# Drizzle
DATABASE_URL=local.db

# Plex
PLEX_SERVER_URL=http://your-plex-server:32400
PLEX_TOKEN=
# Shared secret used in the webhook URL path (/api/webhooks/plex/<token>), since
# Plex does not sign webhook requests. Generate any random string.
PLEX_WEBHOOK_TOKEN=
# Stable id identifying this app instance to plex.tv for the OAuth sign-in flow.
# Any fixed random string (e.g. `openssl rand -hex 16`).
PLEX_CLIENT_IDENTIFIER=

# TMDb (optional) — powers manually logging things not in your Plex library.
# Free API key: themoviedb.org account -> Settings -> API. Leave blank to disable.
TMDB_API_KEY=
